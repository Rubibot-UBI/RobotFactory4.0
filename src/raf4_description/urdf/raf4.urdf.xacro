<?xml version="1.0"?>
<robot name="raf4" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Posição das rodas ===================== -->

  <!-- Roda DIREITA -->
  <xacro:property name="right_wheel_x" value="-0.08316"/>  <!-- frente/trás -->
  <xacro:property name="right_wheel_y" value="-0.00021"/>  <!-- lateral (negativo = direita) -->
  <xacro:property name="right_wheel_z" value="0.00720"/>  <!-- altura (subida 3mm face ao valor original -0.00720) -->

  <!-- Roda ESQUERDA (mede-a separadamente, não assumas que é igual à direita!) -->
  <xacro:property name="left_wheel_x" value="0.08279"/>
  <xacro:property name="left_wheel_y" value="-0.00030"/>
  <xacro:property name="left_wheel_z" value="0.00720"/>  <!-- altura (subida 3mm face ao valor original -0.00725) -->

  <!-- Raio e largura da roda: mede-os também no CAD (não são os do Measure
       que mandaste, são as dimensões da própria roda) -->
  <xacro:property name="wheel_radius" value="0.0235"/>
  <xacro:property name="wheel_width" value="0.013"/>
  <xacro:property name="wheel_mass" value="0.05"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://raf4_description/meshes/raf4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="chassis_color">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://raf4_description/meshes/raf4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ===================== Macro da roda ===================== -->
  <xacro:macro name="wheel" params="prefix x y z yaw">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${yaw}"/>
        <geometry>
          <mesh filename="package://raf4_description/meshes/roda.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="wheel_color">
          <color rgba="0.05 0.05 0.05 1"/>   <!-- quase preto, tipo borracha -->
        </material>
      </visual>
      <collision>
        <!-- Cilindro simples: mais leve/estável para a física do Gazebo
             do que usar a malha completa como collision -->
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <!-- Eixo de rotação = lateral (Y). Se a roda rodar "torta" no Gazebo,
           é aqui que tens de mudar. -->
      <axis xyz="1 0 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="right" x="${right_wheel_x}" y="${right_wheel_y}" z="${right_wheel_z}" yaw="-1.5708"/>
  <xacro:wheel prefix="left"  x="${left_wheel_x}"  y="${left_wheel_y}"  z="${left_wheel_z}"  yaw="1.5708"/>

  <!-- Link do IMU (sem geometria visual, é só um referencial) -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       Ruído calibrado com o datasheet oficial da Bosch
       (BST-BNO055-DS000-16, rev 1.6, secção 1.2 "Electrical and
       physical characteristics, measurement performance").

       "stddev"      = ruído branco por amostra (densidade de ruído
                        do datasheet × raiz da largura de banda usada
                        em modo fusão)
       "bias_stddev" = desvio fixo por arranque (offset/zero-offset
                        do datasheet) — simula o facto de cada BNO055
                        físico ter um pequeno bias próprio que não
                        muda durante a sessão, só entre power-ons
  ==================================================================== -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>  <!-- accel/gyro no BNO055 saem a 100Hz em modo NDOF -->
      <topic>imu/data</topic>
      <imu>
        <angular_velocity>
          <!-- Giroscópio, BW=32Hz (config default do BNO055 em modo fusão).
               Densidade de ruído do datasheet: 0.014 °/s/√Hz
               -> stddev ≈ 0.014 * sqrt(32) ≈ 0.079°/s ≈ 0.0014 rad/s
               Zero-rate offset (bias): típico ±1°/s ≈ 0.0175 rad/s -->
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0014</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0175</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0014</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0175</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0014</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0175</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <!-- Acelerómetro, BW=62.5Hz (config default do BNO055 em modo fusão).
               Densidade de ruído do datasheet: 150 µg/√Hz
               -> stddev ≈ 150e-6 * sqrt(62.5) * 9.81 ≈ 0.0116 m/s²
               Zero-g offset (bias) residual após auto-calibração: ~0.03 m/s² -->
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0116</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.03</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0116</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.03</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0116</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.03</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>

    <!-- Magnetómetro: junto com o imu_sensor acima, dá os 9 eixos do BNO055
         (acelerómetro + giroscópio + magnetómetro).
         No BNO055 real, em modo fusão (NDOF), o magnetómetro só é lido a
         20Hz (é o sensor mais lento dos três) -> update_rate diferente do
         imu_sensor acima, de propósito.
         Ruído "Regular preset" do datasheet: 0.6 µT rms = 0.0000006 T -->
    <sensor name="mag_sensor" type="magnetometer">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>imu/mag</topic>
      <magnetometer>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0000006</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0000006</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0000006</stddev></noise></z>
      </magnetometer>
    </sensor>
  </gazebo>

  <!-- ===================== Controlador de tração (DiffDrive) ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.166</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Publica o ângulo "verdadeiro" (contínuo, sem quantização) de cada
       roda. O DiffDrive acima já dá odometria "perfeita" via física; isto
       aqui é o que dá para simular os encoders REAIS dos motores N20
       (Hall, 7 PPR base x150 redução = 1050 PPR no veio de saída) — a
       quantização/contagem de pulsos é feita do lado do Python, a partir
       deste ângulo contínuo, tal como a firmware de um robô real faria a
       partir dos pulsos A/B do encoder. -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>